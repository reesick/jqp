####################################################################
# jqp — Instagram publishing + comment-to-DM automation
# Copy this file to `.env` (repo root) and fill in every value.
# Run `npm run check-env` after filling this in — it validates the
# whole file and tells you exactly what's missing or malformed.
#
# NEVER commit `.env`. It is already in .gitignore.
####################################################################

# ------------------------------------------------------------------
# APP
# ------------------------------------------------------------------

# development | production
NODE_ENV=development

# Public base URL of the web app. Used to build the Meta OAuth
# redirect URI and the webhook callback URL you paste into Meta.
# Local dev: leave as localhost. Once you run the cloudflared tunnel
# (see docs/LOCAL.md) or deploy to Vercel, update this to the real
# public URL.
APP_BASE_URL=http://localhost:3000

# Any long random string. Protects the dashboard (this app has no
# multi-user auth — it's a single-operator admin tool gated by one
# shared secret cookie). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SHARED_SECRET=

# ------------------------------------------------------------------
# SUPABASE
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------

# Project URL. Settings -> API -> Project URL.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# service_role key. Settings -> API -> Project API keys -> service_role.
# This key bypasses RLS — server-side only, NEVER expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# anon key. Settings -> API -> Project API keys -> anon public.
# Not used for privileged writes; kept for completeness / future use.
SUPABASE_ANON_KEY=

# Postgres connection string, shared by pg-boss (queue), postgres.js
# (our app), and OpenReply's Prisma client. All three hold onto
# LISTEN/NOTIFY or session-scoped state at some point, so this must
# stay a SESSION-mode connection — Settings -> Database -> Connection
# string -> "Session" pooler, or the direct connection (port 5432).
# Do NOT point this at Supabase's "Transaction" pooler (port 6543) —
# pg-boss's LISTEN/NOTIFY breaks under transaction-mode pooling.
# For V1/local dev, the direct (non-pooled) connection string is fine.
# For prod, prefer the Session pooler over direct — same connection
# semantics, but Supabase's own pool sits in front so a burst of
# concurrent serverless invocations doesn't exhaust the database's
# hard connection cap. Verify pg-boss's LISTEN/NOTIFY compatibility
# against Supabase's current pooler docs before switching in prod.
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=

# Max Postgres connections this process's own pool opens (postgres.js
# in web/worker). Kept low (default 5) since four independent
# processes (this app x2, OpenReply web + worker) each open their own
# pool against the same database, and Vercel serverless scale-out
# multiplies the web ones further — smaller per-process ceilings
# matter more than headroom once several processes share one DB.
DB_POOL_MAX=5

# Storage bucket name created by supabase/migrations/0003_storage.sql
SUPABASE_STORAGE_BUCKET=instagram-media

# ------------------------------------------------------------------
# DATA RETENTION (see docs/COMPLIANCE.md)
# Raw Meta webhook payloads are deleted outright; commenter name and
# comment text on DM/comment logs are nulled in place (row kept, so
# historical dashboard counts stay stable). Purge runs daily at 04:00
# UTC from apps/worker. Inspect first with:
#   npx tsx --env-file=.env scripts/purge-dry-run.ts
# ------------------------------------------------------------------
RAW_PAYLOAD_RETENTION_DAYS=30
PII_RETENTION_DAYS=90

# ------------------------------------------------------------------
# META / INSTAGRAM GRAPH API
# App dashboard: https://developers.facebook.com/apps/
# Full click-by-click steps: docs/SETUP.md
# ------------------------------------------------------------------

# App ID. App dashboard -> Settings -> Basic -> App ID.
META_APP_ID=

# App Secret. App dashboard -> Settings -> Basic -> App Secret.
# Used to (a) verify webhook HMAC signatures and (b) exchange/refresh
# long-lived tokens. Treat like a password.
META_APP_SECRET=

# Graph API version currently in use. Meta deprecates versions on a
# schedule — check https://developers.facebook.com/docs/graph-api/changelog
# before deploying. Do not assume this value is still current. (Kept
# in sync with vendor/openreply/.env's META_GRAPH_API_VERSION, which
# shipped v25.0 as of this repo's clone — a fresher signal than this
# build's own training data, so v25.0 is used here too.)
META_GRAPH_VERSION=v25.0

# Base host for Graph API calls. This app uses the Instagram API with
# Instagram Login (NOT Facebook Login for Business) — same product
# OpenReply (vendor/openreply) requires, so one Meta app configuration
# serves both. When creating the Meta app, pick the "Manage messaging
# and content on Instagram" use case, not "Authenticate with Facebook
# Login" (see docs/SETUP.md and vendor/openreply/docs/setup.md Step 4 —
# picking the wrong one breaks the OAuth flow with a mismatched-client
# error). Leave this as graph.instagram.com unless you deliberately
# switch to the Facebook-Login-for-Business flow, which would also
# require rewriting packages/meta/src/oauth.ts.
META_API_BASE=https://graph.instagram.com

# The Instagram-scoped professional (Business/Creator) account ID
# you're publishing to and receiving comments on. This is the
# `user_id` returned by the OAuth token exchange (packages/meta/src/oauth.ts
# exchangeCodeForToken) or by GET https://graph.instagram.com/me?fields=user_id,username
# — NOT the same as any Facebook Page ID.
META_IG_USER_ID=

# Long-lived Page/User access token for META_IG_USER_ID. Bootstrapping
# value only — once connected via the dashboard OAuth flow
# (/api/meta/oauth/start), the app stores an encrypted token per
# account in the `ig_accounts` table and this env var is no longer
# read. Useful to get Phase 2 (one-image publisher) working before
# OAuth is wired up.
META_LONG_LIVED_ACCESS_TOKEN=

# Redirect URI registered in the Meta app for the OAuth flow.
# Must exactly match: App dashboard -> Facebook Login -> Settings ->
# Valid OAuth Redirect URIs. Should be {APP_BASE_URL}/api/meta/oauth/callback
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback

# Arbitrary string YOU choose. Enter the SAME value in Meta's App
# dashboard -> Webhooks -> Instagram -> Verify Token when you subscribe
# the webhook. Meta echoes it back on the GET verification handshake;
# the app checks it matches before returning hub.challenge.
META_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------

# 32-byte (64 hex char) key for AES-256-GCM encryption of stored Meta
# access tokens (ig_accounts.access_token_encrypted). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes stored tokens unrecoverable — you'd have to
# reconnect the Instagram account. Back it up somewhere safe, outside git.
ENCRYPTION_KEY=

# Shared secret the bridge endpoint (/api/internal/published-post)
# requires as a header. Generate the same way as above. Only needed if
# you later run OpenReply or another external service as the DM engine
# and want it to call this endpoint.
BRIDGE_SHARED_SECRET=

# Where OpenReply's own dashboard runs (vendor/openreply, see its own
# .env). Only used for a "open OpenReply dashboard" link on our
# Settings page — DM logs, the inbox, and campaign analytics all live
# there now, not in this app. Local dev default matches
# vendor/openreply/.env's NEXTAUTH_URL (port 3100, chosen to avoid
# colliding with this app's own port 3000).
OPENREPLY_DASHBOARD_URL=http://localhost:3100

# ------------------------------------------------------------------
# QUEUE (pg-boss — runs on the same Postgres as DATABASE_URL above,
# no separate service needed)
# ------------------------------------------------------------------

# Max concurrent jobs the worker process runs at once, across all
# queues. Keep low to avoid tripping Meta rate limits.
QUEUE_CONCURRENCY=5

# ------------------------------------------------------------------
# WORKER (apps/worker, deploys to Render)
# ------------------------------------------------------------------

# Port the worker's health-check HTTP endpoint listens on. Render
# pings this to know the worker is alive.
WORKER_HEALTH_PORT=8080

# ------------------------------------------------------------------
# LOCAL / TESTING ONLY
# ------------------------------------------------------------------

# When true, the Meta client (packages/meta) talks to the local mock
# server (scripts/mock-meta-server.ts) instead of real Graph API hosts.
# Lets you run the ENTIRE publish -> webhook -> DM pipeline locally
# with zero real Instagram calls. See docs/LOCAL.md.
MOCK_META=false
MOCK_META_PORT=8787

# ------------------------------------------------------------------
# AI / CAPTION GENERATION (packages/ai) — off by default
# ------------------------------------------------------------------
# The plan (instagram_automation_updated_plan-1.md, section 84) is
# explicit: do not start with AI, build the publishing pipeline first —
# so this stays OFF unless you turn it on, and it is never called by
# the publish pipeline itself (plan section 7: "AI failure does NOT
# prevent manual posting"). It's a separate pre-step: run
# `npm run generate-caption -- "<folder>" "<brief>"` to WRITE
# caption.md before you ingest the folder. Uses Bedrock's model-agnostic
# Converse API, not Bedrock Agents (plan section 8 — Agents Classic is
# in maintenance mode and closed to new customers as of 30 July 2026).

# Set to true to enable. When true, AWS_REGION and BEDROCK_MODEL_ID
# below become required.
AI_ENABLED=false

# AWS region your Bedrock model access is enabled in, e.g. us-east-1.
AWS_REGION=

# Optional. Leave both blank to use a shared ~/.aws/credentials profile
# or an IAM role instead of explicit keys — the AWS SDK checks those
# automatically. Needs bedrock:InvokeModel permission on the model below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The exact Bedrock model ID to invoke, e.g. a Claude or Nova model ID
# available in your account/region. Run `aws bedrock list-foundation-models
# --region <your-region>` to see what's actually enabled for your
# account — do not guess this value, Bedrock rejects an unavailable
# model ID with a clear error, so it's cheap to just check first.
BEDROCK_MODEL_ID=

# ------------------------------------------------------------------
# OPENREPLY (vendor/openreply) — values only OpenReply's process needs
# ------------------------------------------------------------------
# OpenReply is a separate Next.js app with its OWN .env file
# (vendor/openreply/.env), because Next.js only auto-loads env files
# from its own project directory. Rather than maintaining two files by
# hand, fill in the values below ONCE here, then run:
#   npm run sync-openreply-env
# which generates vendor/openreply/.env from these plus the shared
# META_* values above (see scripts/sync-openreply-env.ts). Re-run it
# any time you change a value here — it's a generated file, don't hand-edit it.

# Local port OpenReply's web app runs on (avoids colliding with this
# app's port 3000). Becomes vendor/openreply/.env's NEXTAUTH_URL.
OPENREPLY_PORT=3100

# Random secrets, independent of this app's own secrets above —
# OpenReply has its own secret store. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OPENREPLY_NEXTAUTH_SECRET=
OPENREPLY_CRON_SECRET=

# 64 hex chars, same rule as this app's own ENCRYPTION_KEY above but a
# DIFFERENT value — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPENREPLY_ENCRYPTION_KEY=

# Upstash Redis (free tier). console.upstash.com/redis -> create a
# database -> copy the ioredis-format connection string (rediss://...).
OPENREPLY_REDIS_URL=

# Resend (free tier, resend.com) for OpenReply's magic-link login.
# Requires a verified sending domain. Alternative: set
# OPENREPLY_EMAIL_SERVER instead (an SMTP URL) to skip Resend entirely
# — see vendor/openreply/.env.example's EMAIL_SERVER comment.
OPENREPLY_RESEND_API_KEY=
OPENREPLY_EMAIL_FROM=OpenReply <login@yourdomain.example>
OPENREPLY_EMAIL_SERVER=

# Optional override — OpenReply's docs table says this CAN differ from
# META_APP_SECRET above (App settings -> Basic -> App secret, vs. the
# Instagram product's own secret page). Leave blank to reuse
# META_APP_SECRET; fill in only if Meta's console shows a different
# value on the Basic settings page.
OPENREPLY_FACEBOOK_APP_SECRET=
