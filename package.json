{
  "name": "jqp",
  "private": true,
  "version": "0.1.0",
  "description": "Instagram carousel publishing + comment-to-DM automation (Meta Graph API only)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:packages": "npm run build -w @jqp/core && npm run build -w @jqp/meta && npm run build -w @jqp/storage && npm run build -w @jqp/queue && npm run build -w @jqp/publisher",
    "build": "npm run build:packages && npm run build --workspace apps/web && npm run build --workspace apps/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "check-env": "tsx scripts/check-env.ts",
    "migrate": "tsx scripts/migrate.ts",
    "ingest": "tsx scripts/ingest-folder.ts",
    "simulate-webhook": "tsx scripts/simulate-webhook.ts",
    "mock-meta": "tsx scripts/mock-meta-server.ts",
    "generate-caption": "tsx scripts/generate-caption.ts",
    "sync-openreply-env": "tsx scripts/sync-openreply-env.ts",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:worker": "npm run dev --workspace apps/worker",
    "build:web": "npm run build --workspace apps/web",
    "build:worker": "npm run build --workspace apps/worker",
    "build:ai": "npm run build -w @jqp/ai",
    "smoke": "tsx scripts/smoke-test.ts",
    "check-redis": "tsx scripts/check-redis.ts",
    "doctor": "tsx scripts/doctor.ts",
    "mcp:selftest": "tsx scripts/mcp-selftest.ts",
    "mcp": "node --import tsx apps/mcp/src/index.ts",
    "set-redis": "tsx scripts/set-redis.ts",
    "set-database-url": "tsx scripts/set-database-url.ts",
    "dm-worker": "node scripts/run-dm-worker.cjs",
    "set-env": "tsx scripts/set-env.ts",
    "test-email": "tsx scripts/test-email.ts",
    "backup": "tsx scripts/backup-db.ts",
    "rotate-db-password": "tsx scripts/rotate-db-password.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
