[Unit]
Description=jqp DM worker (OpenReply)
After=network-online.target
Wants=network-online.target
# Keep retrying forever instead of giving up after a few crashes.
StartLimitIntervalSec=0
# Do not start (not even after a reboot) while the guard has halted the worker. `jqp resume` removes the file.
ConditionPathExists=!/var/lib/jqp-guard/halt

[Service]
Type=simple
User=jqp
Group=jqp
WorkingDirectory=/opt/jqp
EnvironmentFile=/etc/jqp/worker.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --max-old-space-size=384 /opt/jqp/bin/dm-worker.mjs
Restart=always
RestartSec=10
TimeoutStopSec=30
# The VM has 1 GB. This keeps a runaway worker from taking the whole machine down with it.
MemoryMax=600M
# Swap is capped too, otherwise a leak turns into slow swapping instead of a restart.
MemorySwapMax=300M
# The worker only needs to read its own bundle and talk to the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
